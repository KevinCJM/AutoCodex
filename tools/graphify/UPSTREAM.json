{
  "schema_version": "1.0",
  "package": "graphifyy",
  "version": "0.9.27",
  "python": ">=3.11,<3.12",
  "license": "Apache-2.0",
  "upstream": {
    "repository": "https://github.com/Graphify-Labs/graphify",
    "release": "https://github.com/Graphify-Labs/graphify/releases/tag/v0.9.27",
    "pypi": "https://pypi.org/project/graphifyy/0.9.27/"
  },
  "runtime_contract": {
    "executable": "graphify",
    "version_output": "graphify 0.9.27",
    "required_commands": [
      "extract",
      "update",
      "query",
      "affected",
      "path",
      "explain",
      "god-nodes"
    ],
    "extraction_flags": [
      "--code-only",
      "--no-cluster",
      "--max-workers",
      "--force"
    ],
    "graph_schema": {
      "format": "networkx-node-link-json",
      "required_collections": [
        "nodes",
        "links_or_edges"
      ]
    }
  },
  "installation_policy": {
    "isolated": true,
    "global_install": false,
    "platform_install": false,
    "hooks": false,
    "mcp": false,
    "network_install_only_after_explicit_confirmation": true,
    "network_during_graph_build_or_query": false
  }
}
